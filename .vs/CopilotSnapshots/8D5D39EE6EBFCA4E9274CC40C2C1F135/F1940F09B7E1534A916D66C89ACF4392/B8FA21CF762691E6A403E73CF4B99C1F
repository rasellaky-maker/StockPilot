using System.Text.Json;

namespace view.HttpSepClient
{
    public class SepClient
    {
        private HttpClient client = new HttpClient();

        internal SepClient(string baseUrl)
        {
            client.BaseAddress = new Uri(baseUrl);
            client.Timeout = TimeSpan.FromSeconds(10);
            client.DefaultRequestHeaders.Add("X-Api-Key", "348thGFubg7345uff84BIBJJG%fjdgndjgu");
        }
        private async Task<(HttpStatusCode Status, Coin? Coin, string? Error)> HttpBuy(int coinId, int userId, decimal quantity)
        {
            if (coinId <= 0)
                throw new ArgumentOutOfRangeException(nameof(coinId));

            try
            {
                using var form = new FormUrlEncodedContent(new Dictionary<string, string>
                {
                    ["userId"] = userId.ToString(),
                    ["coinId"] = coinId.ToString(),
                    ["quantity"] = quantity.ToString(CultureInfo.InvariantCulture)
                });

                using var response = await client.PostAsync("api/Coin/buy", form);

                if (response.IsSuccessStatusCode)
                {
                    // Server may answer with a Coin, true, a number ... -> do not crash on other formats
                    Coin? coin = null;
                    try
                    {
                        coin = await response.Content.ReadFromJsonAsync<Coin>();
                    }
                    catch (JsonException)
                    {
                        coin = null;
                    }

                    return (response.StatusCode, coin, null);
                }

                var error = await response.Content.ReadAsStringAsync();
                return (response.StatusCode, null, error);
            }
            catch (HttpRequestException)
            {
                return (HttpStatusCode.ServiceUnavailable, null,  ConnectionError());
            }
            catch (TaskCanceledException)
            {
                return (HttpStatusCode.RequestTimeout, null, TimeoutError());
            }
        }
        private async Task<(HttpStatusCode Status, User? User, string? Error)> HttpLogn(User user)
        {
            try
            {
                var data = new Dictionary<string, string>
                {
                    ["username"] = user.Username,
                    ["password"] = user.PassHash
                };

                using var content = new FormUrlEncodedContent(data);

                using var response = await client.PostAsync(
                    "api/User/login",
                    content
                );

                if (response.IsSuccessStatusCode)
                {
                    var loggedUser = await response.Content.ReadFromJsonAsync<User>();

                    if (loggedUser == null)
                    {
                        return (
                            response.StatusCode,
                            null,
                            "Unable to retrieve your account information. Please try again."
                        );
                    }

                    return (response.StatusCode, loggedUser, null);
                }

                if (response.StatusCode == HttpStatusCode.Unauthorized)
                {
                    return (
                        response.StatusCode,
                        null,
                        "Invalid username or password. Please try again."
                    );
                }

                if (response.StatusCode == HttpStatusCode.ServiceUnavailable)
                {
                    return (
                        response.StatusCode,
                        null,
                        "Login service is temporarily unavailable. Please try again later."
                    );
                }

                return (
                    response.StatusCode,
                    null,
                    "Something went wrong while signing in. Please try again later."
                );
            }
            catch (HttpRequestException)
            {
                return (HttpStatusCode.ServiceUnavailable, null, ConnectionError());
            }
            catch (TaskCanceledException)
            {
                return (HttpStatusCode.RequestTimeout, null, TimeoutError());
            }
            catch (JsonException)
            {
                return (HttpStatusCode.InternalServerError, null, InvalidFormatError());
            }
        }
        private async Task<(HttpStatusCode Status, User? User, string? Error)> HttpSingIn(User user)
        {
            try
            {
                var data = new Dictionary<string, string>
                {
                    ["username"] = user.Username,
                    ["password"] = user.PassHash,
                    ["email"] = user.Email
                };

                using var content = new FormUrlEncodedContent(data);

                using var response = await client.PostAsync(
                    "api/User/register",
                    content
                );

                string result = await response.Content.ReadAsStringAsync();

                if (response.IsSuccessStatusCode)
                {
                    var createdUser = JsonSerializer.Deserialize<User>(
                        result,
                        new JsonSerializerOptions
                        {
                            PropertyNameCaseInsensitive = true
                        }
                    );

                    if (createdUser == null)
                    {
                        return (response.StatusCode, null, "User response is empty.");
                    }

                    return (response.StatusCode, createdUser, null);
                }

                return (response.StatusCode, null, result);
            }
            catch (HttpRequestException)
            {
                return (HttpStatusCode.ServiceUnavailable, null, ConnectionError());
            }
            catch (TaskCanceledException)
            {
                return (HttpStatusCode.RequestTimeout, null, TimeoutError());
            }
            catch (JsonException)
            {
                return (HttpStatusCode.InternalServerError, null, InvalidFormatError());
            }
        }
