{
  "ConnectionStrings": {
    "GlobaleConnection": "Server=servername;Port=3306;Database=databasename;Uid=username;Pwd=password;",
  },
  "Database": {
    "MinPoolSize": 1,
    "MaxPoolSize": 10,
    "ConnectionIdleTimeoutSeconds": 60,
    "ConnectionLifetimeSeconds": 300,
    "TcpKeepAliveSeconds": 30,
    "KeepAliveSeconds": 30,
    "ConnectionTimeoutSeconds": 30,
    "CommandTimeoutSeconds": 60
  },
  "CoinPriceUpdater": {
    "Enabled": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
